{
  "name": "Dev Links – Sync Category Buttons",
  "nodes": [
    {
      "id": "5c000001-0000-4000-8000-000000000001",
      "name": "Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 6
            }
          ]
        }
      }
    },
    {
      "id": "5c000001-0000-4000-8000-000000000002",
      "name": "From /sync",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
