      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "5c000001-0000-4000-8000-000000000003",
      "name": "Get Categories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.notion.com/v1/databases/YOUR_NOTION_DATABASE_ID",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "notionApi": {
          "name": "Notion account"
        }
      }
    },
    {
      "id": "5c000001-0000-4000-8000-000000000004",
      "name": "Get Dev Links",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        100
      ],
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5678/api/v1/workflows/YOUR_DEV_LINKS_WORKFLOW_ID",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "n8nApi",
        "options": {}
      },
      "credentials": {
        "n8nApi": {
          "name": "n8n API (local)"
        }
      }
    },
    {
      "id": "5c000001-0000-4000-8000-000000000005",
      "name": "Build Buttons",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        100
      ],
      "parameters": {
        "jsCode": "const manual = $('From /sync').isExecuted;\nconst cats = ($('Get Categories').first().json.properties?.Category?.select?.options || []).map(o => o.name);\nif (!cats.length) throw new Error('No Category options were read from Notion');\n\nconst wf = $input.first().json;\nconst node = wf.nodes.find(n => n.name === 'Send a text message');\nif (!node) throw new Error('\"Send a text message\" node not found in Dev Links');\n\n// Telegram callback data max 64 bytes; \"c|\" + 32-char page id + \"|\" uses 35\nconst bytes = s => unescape(encodeURIComponent(s)).length;\nconst usable = cats.filter(c => bytes(c) <= 29);\nconst skipped = cats.filter(c => bytes(c) > 29);\n\nconst current = (node.parameters.inlineKeyboard?.rows || []).map(r => r.row?.buttons?.[0]?.text);\nconst changed = JSON.stringify(current) !== JSON.stringify(usable) || node.parameters.replyMarkup !== 'inlineKeyboard';\n\nif (changed) {\n  node.parameters.replyMarkup = 'inlineKeyboard';\n  node.parameters.inlineKeyboard = {\n    rows: usable.map(c => ({\n      row: { buttons: [{ text: c, additionalFields: { callback_data: `=c|{{ $json.id.replace(/-/g, '') }}|${c}` } }] }\n    }))\n  };\n}\n\nconst s = wf.settings || {};\nconst settings = {};\nfor (const k of ['executionOrder', 'errorWorkflow', 'callerPolicy', 'saveDataErrorExecution', 'saveDataSuccessExecution', 'saveManualExecutions', 'saveExecutionProgress', 'executionTimeout', 'timezone']) {\n  if (s[k] !== undefined) settings[k] = s[k];\n}\n\nconst warning = skipped.length ? `\\n⚠️ Too long for a button (max 29 characters): ${skipped.join(', ')}` : '';\nreturn [{ json: { changed, manual, usable, warning, body: { name: wf.name, nodes: wf.nodes, connections: wf.connections, settings } } }];"
      }
    },
    {
      "id": "5c000001-0000-4000-8000-000000000006",
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "changed",
              "leftValue": "={{ $json.changed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
