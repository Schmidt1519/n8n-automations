        }
      }
    },
    {
      "id": "5c000001-0000-4000-8000-000000000009",
      "name": "Notify Updated",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1560,
        0
      ],
      "webhookId": "5c000001-0000-4000-8000-0000000000a1",
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🔄 Category buttons updated\n{{ $('Build Buttons').item.json.usable.join(', ') }}{{ $('Build Buttons').item.json.warning }}",
        "additionalFields": {
